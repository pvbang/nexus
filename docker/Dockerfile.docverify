# Verify-only image: chứng minh stack render tài liệu (WeasyPrint+pandoc+fonts)
# hoạt động đúng với đúng base + đúng system deps như Dockerfile production.
# KHÔNG dùng để chạy app — chỉ để chạy test PDF/DOCX font tiếng Việt.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libcairo2 \
    libffi-dev \
    libgdk-pixbuf-2.0-0 \
    libharfbuzz0b \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    pandoc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN pip install --no-cache-dir \
    "markdown-it-py>=3.0" "mdit-py-plugins>=0.4" "weasyprint>=62" \
    "pypandoc>=1.13" "python-docx>=1.1.0" "openpyxl>=3.1.0" \
    "pytest>=8.3" "pytest-asyncio>=0.24" pdfplumber

COPY assets/ assets/
COPY app/documents/ app/documents/
COPY app/__init__.py app/__init__.py
COPY tests/test_render_pdf.py tests/test_render_docx.py tests/test_render_xlsx.py tests/test_render_core.py tests/test_documents_golden_e2e.py tests/
COPY tests/fixtures/ tests/fixtures/

# pytest cần app/ là package nhưng app/documents import app.documents.*
ENV PYTHONPATH=/app
CMD ["python", "-m", "pytest", \
     "tests/test_render_pdf.py", "tests/test_render_docx.py", \
     "tests/test_documents_golden_e2e.py", "-v"]
