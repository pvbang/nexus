# ============================================
# MekongAI Nexus - Root .gitignore
# ============================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl

# Virtual environments
.venv/
venv/
env/
ENV/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# --- Environment ---
.env
.env.local
.env.*.local
.aws-session

# --- Database ---
*.db
*.sqlite3

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
ehthumbs_vista.db

# --- Docker ---
docker-compose.override.yml

# --- Logs ---
*.log
logs/

# --- Node (frontend/) ---
frontend/node_modules/
frontend/dist/
frontend/.cache/

# --- Coverage & Testing ---
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.pytest_cache/
.mypy_cache/

# --- Alembic ---
# Keep versions tracked, but ignore auto-generated pycache
alembic/__pycache__/

# --- Workspace data ---
workspace_data/
uploads/
mcp_servers/

node_modules/

# --- AWS credential/token runtime output (capitol-ai-grafana refresh) ---
# Rewritten on every refresh-aws.sh run (tokens expire ~4h) — runtime output, not
# source. Tracking them just dirties git status after each refresh.
src/open-source/capitol-ai-grafana/**/.aws/credentials
src/open-source/capitol-ai-grafana/output/capitol_creds_refresh.json
src/open-source/capitol-ai-grafana/output/capitol_creds_history.jsonl

# --- Downloaded installers (not source; pandoc is installed in the Docker image) ---
*.msi
# --- Personal / authorization data: NEVER commit (use *.example files) ---
developer_profile.json
pentest_scope.yaml
docker_logs_*.txt
