# ============================================
# MekongAI Nexus - Environment Configuration
# ============================================
# Copy file này thành .env và điền các giá trị cần thiết
# cp .env.example .env
#
# pydantic-settings: case_sensitive=False → FIELD_NAME maps to field_name in app/config.py

# --- Application ---
APP_NAME=MekongAI Nexus
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
# Tạo: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=change-me-in-production

# --- Database ---
# Local dev: dùng port gốc 5432 (PostgreSQL chuẩn)
# Docker Compose: backend kết nối postgres:5432 (internal, tự override)
# Nếu dùng Docker DB từ local: đổi sang localhost:5433 (Docker host port)
# QUAN TRỌNG: Password PHẢI khớp với POSTGRES_PASSWORD bên dưới
DATABASE_URL=postgresql+asyncpg://mekongai:MekongAI2026@localhost:5432/mekongai_nexus
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# --- Docker Compose PostgreSQL credentials ---
# PHẢI khớp với password trong DATABASE_URL ở trên
# Nếu đã tạo volume trước đó với password khác, phải xoá volume cũ:
#   docker compose down -v && docker compose up -d --build
POSTGRES_DB=mekongai_nexus
POSTGRES_USER=mekongai
POSTGRES_PASSWORD=MekongAI2026

# --- Redis ---
# Local dev: dùng port gốc 6379 (Redis chuẩn)
# Docker Compose: tự override thành redis:6379
REDIS_URL=redis://localhost:6379/0

# ============================================
# LLM Configuration
# ============================================
# Hỗ trợ (đều OpenAI-compatible trừ khi ghi chú khác):
#   bedrock | openai | gemini | openrouter | deepseek | groq | xai | mistral |
#   together | fireworks | cerebras | moonshot | deepinfra | dashscope |
#   local | kilo | pollinations | g4f
#
# Cách chọn LLM chính: set CORE_LLM_PROVIDER + CORE_LLM_MODEL (và AGENT_LLM_* cho
# sub-agent). API key có thể để trong CORE_LLM_API_KEY, HOẶC dùng biến env riêng
# của provider (vd DEEPSEEK_API_KEY) — hệ thống tự nhặt. Ví dụ từng provider ở
# ngay dưới phần cấu hình chính này.

# --- Core Agent LLM (model mạnh nhất cho reasoning phức tạp) ---
# Kilo Gateway: free, anonymous, không cần API key (200 req/hour/IP)
CORE_LLM_PROVIDER=kilo
CORE_LLM_API_KEY=
CORE_LLM_BASE_URL=
CORE_LLM_MODEL=kilo-auto/free

# --- Sub-Agent LLM (model tiết kiệm, vẫn hỗ trợ function calling) ---
# Kilo Gateway: dùng chung free tier, tự động route tới model tốt nhất
AGENT_LLM_PROVIDER=kilo
AGENT_LLM_API_KEY=
AGENT_LLM_BASE_URL=
AGENT_LLM_MODEL=kilo-auto/free

# --- AWS Bedrock ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# AWS_SESSION_TOKEN=            # only for temporary STS credentials
# Background session-token refresher (refresh-aws.sh / IMDS bridge):
#   unset = AUTO (on only when a bedrock provider is used AND AWS_SESSION_TOKEN
#                 is set — i.e. there is a rotating STS token to refresh)
#   true  = always run it
#   false = never run it (static/long-lived IAM key, or bedrock not used)
# A session key sourced from refresh-aws.sh / the environment always outranks
# the value in .env; this flag only controls WHETHER the rotation loop runs.
# AWS_TOKEN_REFRESH_ENABLED=

# --------------------------------------------
# Ví dụ cấu hình từng provider (bỏ dấu # để dùng)
# --------------------------------------------
# Mỗi block: set CORE_LLM_PROVIDER trỏ tới provider, rồi điền API key vào biến
# env riêng của provider đó (hoặc CORE_LLM_API_KEY). BASE_URL để trống = dùng
# endpoint mặc định của provider (đã cấu hình sẵn trong code).

# --- OpenAI (GPT-4.1 / GPT-4o / o-series) ---
# CORE_LLM_PROVIDER=openai
# CORE_LLM_MODEL=gpt-4.1
OPENAI_API_KEY=

# --- OpenRouter (300+ models, nhiều model free) — key tại https://openrouter.ai/keys ---
# CORE_LLM_PROVIDER=openrouter
# CORE_LLM_BASE_URL=https://openrouter.ai/api/v1
# CORE_LLM_MODEL=anthropic/claude-sonnet-4-20250514
OPENROUTER_API_KEY=

# --- Google Gemini — key free tại https://aistudio.google.com/app/apikey ---
# CORE_LLM_PROVIDER=gemini
# CORE_LLM_MODEL=gemini-2.0-flash
# GOOGLE_API_KEY=AIzaSyXXXXX

# --- DeepSeek (deepseek-chat / deepseek-reasoner) — https://api-docs.deepseek.com ---
# CORE_LLM_PROVIDER=deepseek
# CORE_LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# --- Groq (LPU siêu nhanh: Llama/Kimi/GPT-OSS) — https://console.groq.com ---
# CORE_LLM_PROVIDER=groq
# CORE_LLM_MODEL=moonshotai/kimi-k2-instruct
GROQ_API_KEY=

# --- xAI Grok — https://docs.x.ai ---
# CORE_LLM_PROVIDER=xai
# CORE_LLM_MODEL=grok-4
XAI_API_KEY=

# --- Mistral — https://docs.mistral.ai ---
# CORE_LLM_PROVIDER=mistral
# CORE_LLM_MODEL=mistral-large-latest
MISTRAL_API_KEY=

# --- Together AI (OSS models: Llama/Qwen/DeepSeek) — https://docs.together.ai ---
# CORE_LLM_PROVIDER=together
# CORE_LLM_MODEL=deepseek-ai/DeepSeek-V3
TOGETHER_API_KEY=

# --- Fireworks AI — https://docs.fireworks.ai ---
# CORE_LLM_PROVIDER=fireworks
# CORE_LLM_MODEL=accounts/fireworks/models/deepseek-v3
FIREWORKS_API_KEY=

# --- Cerebras (wafer-scale, tốc độ cực cao) — https://inference-docs.cerebras.ai ---
# CORE_LLM_PROVIDER=cerebras
# CORE_LLM_MODEL=llama-3.3-70b
CEREBRAS_API_KEY=

# --- Moonshot / Kimi — https://platform.moonshot.ai ---
# CORE_LLM_PROVIDER=moonshot
# CORE_LLM_MODEL=kimi-k2-0711-preview
MOONSHOT_API_KEY=

# --- DeepInfra (OSS models giá rẻ) — https://deepinfra.com/docs ---
# CORE_LLM_PROVIDER=deepinfra
# CORE_LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
DEEPINFRA_API_KEY=

# --- DashScope / Alibaba Qwen (endpoint quốc tế) — https://www.alibabacloud.com/help/en/model-studio ---
# CORE_LLM_PROVIDER=dashscope
# CORE_LLM_MODEL=qwen-max
DASHSCOPE_API_KEY=

# --- Anthropic Claude: dùng qua provider=bedrock (ở trên) hoặc provider=openrouter ---
#     (không có path OpenAI-compat riêng vì prompt-caching cần định dạng Bedrock/OpenRouter)

# --- Local LLM (Ollama/vLLM) ---
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:32b

# ============================================
# Kilo Gateway (Free Models - No API Key Required)
# ============================================
# Anonymous access via IP-based rate limiting (200 requests/hour/IP)
# No OPENROUTER_API_KEY or account required - works out of the box
# Available free models (no API key needed):
#   - kilo-auto/free (auto-routed to best available free model)
#   - nvidia/nemotron-3-super-120b-a12b:free
#   - poolside/laguna-m.1:free
#   - openrouter/free
KILO_GATEWAY_ENABLED=true
KILO_GATEWAY_BASE_URL=https://api.kilo.ai/api/gateway/v1

# --- Pollinations AI (Free Anonymous Models) ---
POLLINATION_ENABLED=true
POLLINATION_BASE_URL=https://text.pollinations.ai/openai

# --- GPT4Free (Anonymous AI Models) ---
# pip install g4f
G4F_ENABLED=true

# ============================================
# Embedding Configuration (optional — best-effort)
# ============================================
# Nếu để trống, hệ thống dùng core_llm_provider (vd: bedrock → litellm.aembedding).
# Nếu muốn dùng OpenAI embeddings riêng (rẻ + nhanh), cấu hình như bên dưới.
#
# Option A: Dùng cùng provider với Core LLM (mặc định, không cần config gì)
# EMBEDDING_PROVIDER=
# EMBEDDING_MODEL=
#
# Option B: Dùng OpenAI embedding riêng (recommended nếu có OpenAI key)
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=sk-xxxxx
#
# Option C: Dùng local Ollama embedding
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_BASE_URL=http://localhost:11434/v1
#
# Option D: Dùng HuggingFace sentence-transformers (offline, không cần API key)
# Model tự download từ HuggingFace Hub lần đầu, sau đó cache local.
# Default: Qwen3-Embedding-0.6B (multilingual, hỗ trợ tiếng Việt, 1024 dims)
# EMBEDDING_PROVIDER=huggingface
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# Các model khác:
#   - intfloat/multilingual-e5-small (384 dims, nhỏ, multilingual)
#   - BAAI/bge-small-en-v1.5 (384 dims, English)
#   - sentence-transformers/all-MiniLM-L6-v2 (384 dims, English, rất nhẹ)
#
# LƯU Ý: Dù EMBEDDING_PROVIDER là gì, hệ thống LUÔN pre-load Qwen3-Embedding
# làm fallback. Nếu primary provider fail → tự động dùng local model.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# Vector dimensions (0 = auto-detect from model defaults)
# titan-embed-v2: 1024, text-embedding-3-small: 1536, Qwen3-Embedding: 1024
# Chỉ set nếu muốn override, mặc định auto-detect theo model
EMBEDDING_DIMENSIONS=0

# HuggingFace Hub token (optional): dùng để tải model private hoặc gated models.
# Lấy tại: https://huggingface.co/settings/tokens
HF_TOKEN=

# ============================================
# Memory & Services
# ============================================

# Zep Cloud (long-term memory, tùy chọn): https://app.getzep.com/
ZEP_API_KEY=

# --- Sandbox ---
# IronClaw: WASM-based sandbox (Rust binary). Enabled = use as primary sandbox.
# Nếu binary chưa build, hệ thống TỰ ĐỘNG fallback sang Docker/process.
# Build: cd src/open-source/ironclaw && cargo build --release
IRONCLAW_BINARY_PATH=./src/open-source/ironclaw/target/release/ironclaw
IRONCLAW_ENABLED=true
DOCKER_SANDBOX_ENABLED=true
DOCKER_SANDBOX_IMAGE=python:3.12-slim

# --- ACTIVITY logging ---
# 0 = no truncation (full fidelity). Set a positive int to truncate tool outputs in ACTIVITY.md for readability.
ACTIVITY_TOOL_OUTPUT_MAX_CHARS=0

# --- MCP ---
MCP_SERVERS_DIR=./mcp_servers
MCP_AUTO_DISCOVER=true
# External MCP servers (JSON array). Examples:
# [{"name":"filesystem","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]},
#  {"name":"github","command":"npx","args":["-y","@modelcontextprotocol/server-github"],"env":{"GITHUB_TOKEN":"ghp_xxx"}},
#  {"name":"custom-api","url":"http://localhost:3001"}]
MCP_SERVERS=

# ============================================
# Tunnel / Public URLs (no API keys required)
# ============================================
# Tunnel tool can auto-download cloudflared into WORKSPACE_DIR/bin in many environments.
# Optional SSH fallback if you prefer: set to a public SSH reverse-tunnel host (serveo.net, localhost.run, etc.)
TUNNEL_SSH_HOST=
BORE_SERVER=bore.pub

# ============================================
# Channels (tất cả optional — chỉ cấu hình kênh bạn cần)
# ============================================

# --- Telegram ---
# https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
# Background getUpdates poll loop (inbound message -> router). OFF by default:
# getUpdates is single-consumer, so a background poller competes with the
# agent-facing telegram_get_updates tool (409 Conflict) and swallows owner
# replies. Enable only if you want "message the bot to assign work".
TELEGRAM_POLLING_ENABLED=false

# --- Discord ---
# https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
# Comma-separated guild IDs for faster slash command sync (optional)
DISCORD_GUILD_IDS=
DISCORD_COMMAND_PREFIX=!
DISCORD_DEFAULT_CHANNEL_ID=

# --- Slack ---
# https://api.slack.com/apps
SLACK_BOT_TOKEN=
# Socket Mode app token (xapp-...): Basic Information → App-Level Tokens
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_DEFAULT_CHANNEL=

# --- WhatsApp (Baileys bridge hoặc Meta Cloud API) ---
# config.py: whatsapp_enabled, whatsapp_api_url, whatsapp_api_token, whatsapp_phone_number_id, whatsapp_mode
WHATSAPP_ENABLED=false
WHATSAPP_MODE=bridge
WHATSAPP_API_URL=http://localhost:3001
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_TOKEN=
WHATSAPP_DEFAULT_TO=

# --- Email (IMAP + SMTP) ---
# config.py: email_imap_host, email_imap_port, email_smtp_host, email_smtp_port,
#            email_username, email_password, email_from_address
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=
# Auto-poll inbound mail → auto-create tasks. Leave false unless you want to
# assign work by emailing the agent. Credentials above still power the
# fetch_emails / send_email tools regardless of this flag.
EMAIL_CHANNEL_ENABLED=false

# --- Webhook (generic HTTP) ---
WEBHOOK_SECRET=

# --- Matrix ---
MATRIX_HOMESERVER=
MATRIX_USER_ID=
MATRIX_ACCESS_TOKEN=

# --- Signal (signal-cli-rest-api) ---
SIGNAL_API_URL=http://localhost:8080
SIGNAL_PHONE_NUMBER=
SIGNAL_DEFAULT_RECIPIENT=

# --- SMS (Twilio) ---
# config.py: sms_account_sid, sms_auth_token, sms_phone_number
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_PHONE_NUMBER=

# ============================================
# Image Generation (tùy chọn)
# ============================================
# fal.ai FLUX (miễn phí 10 ảnh/ngày): https://fal.ai/dashboard/keys
FAL_KEY=
# OpenAI DALL-E 3 (dùng OPENAI_API_KEY ở trên)

# ============================================
# Web Search Engines (tất cả optional)
# ============================================
# Không có API key nào cũng OK — hệ thống tự fallback về DuckDuckGo (free).
# Thêm API keys để tăng chất lượng + đa nguồn + freshness scoring.

# Brave Search (free tier: 2000 queries/month): https://brave.com/search/api/
BRAVE_API_KEY=

# Tavily AI Search (free tier: 1000 queries/month, tối ưu cho AI agents):
# https://tavily.com/ → Dashboard → API Keys
TAVILY_API_KEY=

# Serper.dev (Google Search wrapper, free tier: 2500 queries):
# https://serper.dev/ → Dashboard → API Key
SERPER_API_KEY=

# SearXNG (self-hosted meta-search): set to your instance URL
SEARXNG_URL=

# ============================================
# Security
# ============================================

# Admin Login Credentials
# Đặt ADMIN_PASSWORD để bật authentication. Để trống = tắt auth (dev mode).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Ưu tiên hơn ADMIN_PASSWORD: bcrypt hash ($mkv2$…). So sánh hằng-thời-gian, an toàn hơn plaintext.
# Tạo: python -c "from app.core.password import hash_password; print(hash_password('mat-khau-cua-ban'))"
ADMIN_PASSWORD_HASH=

# JWT Authentication (internal — không cần nhớ, chỉ dùng để sign token)
# Tạo: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Tăng số này để thu hồi (revoke) TẤT CẢ token đã phát hành trước đó → buộc đăng nhập lại.
JWT_TOKEN_VERSION=0

# Terminal API key (protects /terminal endpoints in production)
# Tạo: python -c "import secrets; print(secrets.token_hex(32))"
TERMINAL_API_KEY=

# --- CORS ---
# Chỉ thêm origins mà BROWSER cần truy cập (không thêm internal Docker hostnames)
CORS_ORIGINS=https://nexus.mekongai.com,http://localhost:3000,http://localhost:8899,http://localhost:8000,http://localhost:3099,http://localhost:18789

# --- Tool Policy (OpenClaw-inspired) ---
TOOL_POLICY_ENABLED=true
TOOL_POLICY_DEFAULT_ACTION=ask
TOOL_POLICY_WORKSPACE_ONLY=true

# --- SSRF Guard (OpenClaw-inspired) ---
SSRF_GUARD_ENABLED=true
SSRF_ALLOW_LOCALHOST=false
SSRF_ALLOW_PRIVATE=false

# --- Approval Workflow (OpenClaw-inspired) ---
APPROVAL_TIMEOUT_SECONDS=120
APPROVAL_MAX_PENDING=50

# --- Security Audit ---
SECURITY_AUDIT_ON_STARTUP=false
# Cron expression cho periodic audits (empty = disabled)
# Ví dụ: "0 3 * * *" = chạy lúc 3 giờ sáng mỗi ngày
SECURITY_AUDIT_CRON=

# ============================================
# Smart Model Routing (Hermes-agent inspired)
# ============================================
# Tự động route câu hỏi đơn giản → Agent LLM (rẻ hơn)
# Câu phức tạp (code, debug, architecture...) → Core LLM (mạnh nhất)
# QUAN TRỌNG: Bật để tiết kiệm chi phí ~60% cho simple queries
SMART_ROUTING_ENABLED=true
SMART_ROUTING_MAX_CHARS=160
SMART_ROUTING_MAX_WORDS=28

# ============================================
# Provider Fallback Chain (Hermes-agent inspired)
# ============================================
# Fallback chain is built automatically by get_core_llm_with_fallback():
# 1. Core LLM (configured) → 2. Agent LLM (if different) → 3. Kilo Gateway FREE
# KILO_GATEWAY_ENABLED=true ensures free models are ALWAYS available as last resort
# No API key needed for Kilo models - anonymous access via IP rate limiting (200/hr/IP)
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_PROVIDERS=
LLM_FALLBACK_MAX_FAILURES=3
LLM_FALLBACK_COOLDOWN=60

# ============================================
# Credential Pool Rotation (Hermes-agent inspired)
# ============================================
# JSON mapping: provider → list of API keys
# Ví dụ: {"openrouter": ["sk-or-key1", "sk-or-key2"], "anthropic": ["sk-ant-1", "sk-ant-2"]}
LLM_CREDENTIAL_POOL=
LLM_CREDENTIAL_COOLDOWN=1200

# ============================================
# Docker Port Mapping (tránh trùng port phổ biến)
# ============================================
# Chỉ dùng cho docker-compose, KHÔNG ảnh hưởng local dev
NEXUS_PG_PORT=5433
NEXUS_REDIS_PORT=6380
NEXUS_BACKEND_PORT=8899
NEXUS_FRONTEND_PORT=3099
NEXUS_PUBLIC_GATEWAY_PORT=18800

# ============================================
# Agent Intelligence Enhancement (Phase 2-8)
# ============================================

# --- ReAct Execution Loop (Phase 3) ---
USE_REACT_LOOP=true

# --- Tool Feature Gates (Phase 2) ---
# Format: tool_name:true/false (comma-separated)
TOOL_GATES=

# --- Workspace Directory ---
WORKSPACE_DIR=workspace_data

# --- External Access (Dev Server URLs cho user bên ngoài) ---
# URL base mà user truy cập preview app (https://<domain>/preview/<port>/).
# ĐỂ TRỐNG cũng được: hệ thống TỰ HỌC domain từ request (Host/X-Forwarded-Host)
# nên link preview thường đúng mà không cần set.
# KHUYẾN NGHỊ PRODUCTION: vẫn nên set = domain thật (vd https://nexus2.mekongai.com)
# để (a) chắc chắn đúng và (b) chống Host-header spoofing (config luôn override
# giá trị tự-học → request giả mạo Host không ảnh hưởng link đưa cho user).
EXTERNAL_BASE_URL=
# Public hostname/IP for dev server preview URLs (used when running in Docker)
# Khi chạy trong Docker, IP detection sẽ trả về 172.x.x.x (Docker internal).
# Set biến này để trả URL đúng cho user bên ngoài truy cập.
# NEXUS_PUBLIC_HOST=your-server-ip-or-domain
# Tự động mở port trên firewall (ufw/iptables) khi start dev server
AUTO_OPEN_FIREWALL_PORT=true

# --- Deep Reasoning (Phase 6: Agent Intelligence) ---
DEEP_ANALYSIS_ENABLED=true
SELF_REFLECTION_ENABLED=true
SELF_REFLECTION_INTERVAL=3
CRITIC_AUTO_SPAWN=true
CRITIC_IN_DEBATE=true

# ============================================
# Sub-Agent LLM Configuration Guide
# ============================================
# QUAN TRỌNG: Model miễn phí (nemotron:free) KHÔNG hỗ trợ function calling!
#
# Option A: Bedrock Sonnet (recommended — mạnh, rẻ hơn Opus ~5x)
# AGENT_LLM_PROVIDER=bedrock
# AGENT_LLM_MODEL=us.anthropic.claude-opus-4-6-v1
#
# Option B: OpenRouter paid model
# AGENT_LLM_PROVIDER=openrouter
# AGENT_LLM_API_KEY=your_openrouter_key
# AGENT_LLM_BASE_URL=https://openrouter.ai/api/v1
# AGENT_LLM_MODEL=anthropic/claude-sonnet-4-20250514
#
# Option C: Gemini Flash (nhanh, rẻ, hỗ trợ tools)
# AGENT_LLM_PROVIDER=gemini
# AGENT_LLM_API_KEY=AIzaSyXXXXX
# AGENT_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AGENT_LLM_MODEL=gemini-2.0-flash
#
# Option D: Model miễn phí CÓ hỗ trợ tools (OpenRouter)
# AGENT_LLM_PROVIDER=openrouter
# AGENT_LLM_API_KEY=your_openrouter_key
# AGENT_LLM_BASE_URL=https://openrouter.ai/api/v1
# AGENT_LLM_MODEL=google/gemini-2.0-flash-exp:free
#
# Option E: DeepSeek (rẻ, native function-calling tốt) — key ở DEEPSEEK_API_KEY
# AGENT_LLM_PROVIDER=deepseek
# AGENT_LLM_MODEL=deepseek-chat
#
# Option F: Groq (siêu nhanh, native tools) — key ở GROQ_API_KEY
# AGENT_LLM_PROVIDER=groq
# AGENT_LLM_MODEL=moonshotai/kimi-k2-instruct
#
# (Các provider khác: xai, mistral, together, fireworks, cerebras, moonshot,
#  deepinfra, dashscope — xem block "Ví dụ cấu hình từng provider" phía trên)

# ============================================
# Agent Execution Limits (0 = unlimited)
# ============================================
AGENT_MAX_ROUNDS=0
AGENT_MAX_TOOL_CALLS=0
SWARM_MAX_ROUNDS=0
REACT_MAX_ROUNDS=0
SUB_AGENT_MAX_ROUNDS=0
AGENT_REASONING_EFFORT=xhigh
AGENT_MAX_RETRIES=3

# ============================================
# Performance Tuning
# ============================================
TOOL_TIMEOUT=3000
# Agent execution tunables (M3). Defaults shown; uncomment to override.
# AGENT_TOOL_OUTPUT_CAP_CHARS=20000      # cap tool output injected into LLM messages
# CONTEXT_COMPRESS_THRESHOLD_CHARS=60000 # compress older tool results past this size
TOOL_MAX_CONCURRENT=5
PIPELINE_TIMEOUT=180000
# Auto-retry pipeline on timeout (total attempts = 1 + retries, progressive timeout increase)
PIPELINE_MAX_RETRIES=2
# SSE stale timeout (seconds): if no event for this long, move task to background.
# NOT an absolute limit — active tasks run forever as long as events keep flowing.
# Default 3000s in config. Set higher if agents have very long-running tools.
# Note: LLM_CALL_TIMEOUT (per-call) is 900s; DEFAULT_STALE_TIMEOUT (stream gap) is 300s.
MAX_STREAM_DURATION=3000

# ============================================
# Hermes Agent Integration (In-Process)
# ============================================
HERMES_ENABLED=true
HERMES_PATH=src/open-source/hermes-agent
HERMES_EXPOSE_TERMINAL_TOOLS=true
HERMES_EXPOSE_CODE_EDIT=true
HERMES_EXPOSE_BATCH_RUNNER=true
HERMES_EXPOSE_SESSION_SEARCH=true
HERMES_TERMINAL_BACKEND=local

# ============================================
# OpenClaw Gateway Integration (Execution Layer)
# ============================================
# OpenClaw Gateway URL (để trống = disabled):
#   - Docker Compose: http://openclaw:18789
#   - Cùng VPS không Docker: http://localhost:18789
OPENCLAW_GATEWAY_URL=
# Tạo: python -c "import secrets; print(secrets.token_hex(24))"
OPENCLAW_GATEWAY_TOKEN=
# Tạo: python -c "import secrets; print(secrets.token_hex(16))"
OPENCLAW_INTERNAL_SECRET=
OPENCLAW_SUBPROCESS_ENABLED=false
OPENCLAW_DIST_PATH=./src/open-source/openclaw/dist/index.js
OPENCLAW_WORKSPACE_DIR=./workspace_data
# Model mặc định cho OpenClaw (format: provider/model-id)
# Docker Compose mount file docker/openclaw.json chứa config này
# Nếu dùng Bedrock: bedrock/us.anthropic.claude-opus-4-6-v1
# Nếu dùng OpenAI: openai/gpt-4.1
# Nếu dùng OpenRouter: openrouter/anthropic/claude-sonnet-4-20250514
# Nếu dùng Kilo free (anonymous): kilocode/kilo/auto
OPENCLAW_MODEL=kilocode/kilo/auto

# ============================================
# Stealth Browser (Anti-Bot Bypass)
# ============================================
# Enable stealth mode for browser automation (default: true)
BROWSER_USE_STEALTH=true
# Browser engine: auto | patchright | camoufox (default: auto)
# auto = try Patchright first, fallback to Camoufox
STEALTH_ENGINE=auto
# Headless mode (default: true, set false for debugging or when heavily blocked)
BROWSER_USE_HEADLESS=true
# Explicit proxy (optional - overrides free proxy pool)
# STEALTH_PROXY_URL=http://user:pass@proxy-host:port
# Byparr service URL for Cloudflare challenge bypass (Docker)
# Start with: docker run -d -p 8191:8191 thephaseless/byparr:latest
# BYPARR_URL=http://localhost:8191

# ============================================
# Regulatory Oversight & Authorization
# ============================================
# SAFETY (audit CC-10): standing authorization is OFF by default. It records WHO
# is accountable at the deployment level — it is NOT a waiver and never sweeps a
# target under blanket scope (each in-scope target still needs real ownership /
# written permission, and real public infrastructure is always excluded).
# Only enable this if your deployment genuinely holds standing authorization, and
# set the org/basis to YOUR real accountable party — never ship a generic or
# government-sounding name as an active default.
ROE_STANDING_AUTHORIZATION=false
# ROE_AUTHORIZING_ORG=
# ROE_AUTHORIZATION_BASIS=

# --- Live offensive (pentest) authorization ------------------------------------
# Two ways to authorize live offensive work against real public infrastructure:
#
# 1) PER-TARGET SCOPE (recommended, multi-tenant). Declare each authorized
#    engagement — org + document + the exact targets it covers — in a scope file.
#    A target is allowed ONLY if it appears in the scope; everything else is
#    blocked. This is how you serve many parties (each authorizing their OWN
#    assets) without a blanket flag. Copy pentest_scope.example.yaml →
#    pentest_scope.yaml and fill it in. Point this at it (default: project root):
# PENTEST_SCOPE_FILE=pentest_scope.yaml
#
# 2) GLOBAL FLAG (single-tenant / all-targets). Authorizes EVERY public target —
#    use only on a deployment dedicated to one authorized engagement. Leave OFF if
#    you use the per-target scope above.
# ALLOW_LIVE_OFFENSIVE=0